<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host gives each plugin assembly: Ecs for the primitives, Wire for the log and the catalog. -->
    <ProjectReference Include="../../App/Host/App.Host.csproj" />
    <!-- The boundary tests load each App assembly of Base.slnx. -->
    <ProjectReference Include="../../App/Cli/App.Cli.csproj" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
