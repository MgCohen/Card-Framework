{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rulebook",
  "type": "object",
  "required": [
    "version",
    "books",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "string",
              "list",
              "bool",
              "enum"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "help": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "book",
          "title",
          "rule",
          "why",
          "fix",
          "status",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2,}$"
          },
          "book": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "status": {
            "enum": [
              "enforced",
              "planned"
            ]
          },
          "check": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "asmdef.noCycles",
                  "asmdef.allowedReferences",
                  "asmdef.forbiddenReferences",
                  "ivt.allowlist",
                  "il.callersOnly",
                  "il.forbiddenCalls",
                  "type.memberTypes",
                  "type.noSubtypesIn",
                  "feature.hasTests",
                  "tests.requireAttribute",
                  "attached",
                  "agent.review"
                ]
              },
              "params": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "reason",
                "until"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "until": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "extra": {
            "type": "object",
            "description": "Values for the custom fields defined in the top-level fields list."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
